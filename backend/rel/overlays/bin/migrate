#!/bin/sh
# Runs all pending Ecto migrations inside the release.
#
# Used as the platform release_command (fly.toml) and by the backup/restore
# drill in docs/ops.md. Requires DATABASE_URL (or discrete PG vars) in the env.
set -eu

cd -P "$(dirname "$0")/.."

exec bin/sports_coach_bookings eval "SportsCoachBookings.Release.migrate()"
