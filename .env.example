# SportsCoachBookings runtime environment (EXAMPLE — no real secrets here).
#
# Copy to `.env` for local docker-compose / release runs. `.env` is gitignored.
# Production values are set as platform secrets (Fly secrets), never committed.
# See docs/ops.md for the full runbook.

# --- Required in production ------------------------------------------------
# Signs/encrypts cookies and sessions. `mix phx.gen.secret`.
SECRET_KEY_BASE=
# `ecto://USER:PASS@HOST:PORT/DB` where USER is the non-superuser scb_app role.
DATABASE_URL=ecto://scb_app:scb_app@localhost:5432/sports_coach_bookings_dev
# 32 random bytes, base64. Vault for player medical data.
#   mix run -e 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
PLAYER_MEDICAL_ENCRYPTION_KEY=
# Apex host and wildcard base domain (e.g. sportscoachbookings.com).
PHX_HOST=localhost
BASE_DOMAIN=localhost
PLATFORM_HOST=localhost

# --- Server tuning ---------------------------------------------------------
PORT=4000
POOL_SIZE=10
# "true" when the managed Postgres requires TLS.
ECTO_SSL=false
# "true"/"1" to prefer IPv6 (some platforms need it for the DB socket).
ECTO_IPV6=false
# Where the built SPA bundles live (Docker image uses /app).
REPO_ROOT=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NOTIFICATIONS_FROM_ADDRESS=notifications@mail.sportscoachbookings.com
APP_URL=https://sportscoachbookings.com

# --- Stripe Connect --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_TYPE=express
STRIPE_PLATFORM_FEE_BPS=0

# --- Object storage (S3-compatible) ---------------------------------------
# Leave S3_BUCKET unset to use the deterministic local Fake backend.
S3_BUCKET=
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# RustFS/MinIO/R2 only; leave unset for AWS S3.
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=900
S3_FORCE_PATH_STYLE=false

# --- Observability ---------------------------------------------------------
# Module exporting capture_exception/4 (e.g. a Sentry adapter). Unset = log only.
ERROR_REPORTER_MODULE=
